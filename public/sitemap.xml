<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap covering the fixed routes.

  Product, collection and journal URLs are generated from Supabase at request
  time and are not listed here: emitting them would mean either a build-time
  database fetch (stale the moment an admin publishes) or a serverless function.
  Crawlers reach them by following links from /collections and /journal, which
  are both listed below and both render server-visible anchor tags.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>/collections</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>/journal</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>/events</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>/collaborations</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
