VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Serves responsive srcset variants through Supabase's image
# transformation endpoint (/storage/v1/render/image/public/...).
# That endpoint is a Pro-plan feature — on Free it returns 404 and every image
# breaks. Leave it unset until the project is on Pro or above; without it the
# client-side optimizer still caps uploads at 2400px and re-encodes to WebP.
# VITE_SUPABASE_IMAGE_TRANSFORM=true
